{
  "appId": "com.prodev.car2d",
  "appName": "Turbo 2D Racing",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    },
    "ScreenOrientation": {
      "orientation": "portrait"
    }
  }
}
